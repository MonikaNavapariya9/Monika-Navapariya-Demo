{% liquid
  assign section_id = 'tisso-gift-banner-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="tisso-gift-banner"
  data-section-id="{{ section.id }}"
>
  <div class="tisso-gift-banner__topbar">
    <div class="page-width">
    <div class="tisso-gift-banner__topbar-inner">

      <div class="tisso-gift-banner__topbar-logo">
        <img src="{{ section.settings.logo_text | img_url: 'master' }}" />
      </div>

      <div class="tisso-gift-banner__topbar-message">
        {{ section.settings.topbar_message }}
      </div>

      {% if section.settings.show_topbar_button %}
        <button
          type="button"
          class="tisso-gift-banner__gift-button tisso-gift-banner__animated-button"
          data-tisso-popup-open
          aria-haspopup="dialog"
        >
          <span>{{ section.settings.topbar_button_text }}</span>
          <span class="tisso-gift-banner__button-arrow" aria-hidden="true">
            →
          </span>
        </button>
      {% endif %}

    </div>
  </div>
  </div>

  <div class="tisso-gift-banner__mobile-drawer">
    <div class="page-width">
     <div class="tisso-gift-banner__topbar-message">
        {{ section.settings.topbar_message }}
      </div>

      {% if section.settings.show_topbar_button %}
        <button
          type="button"
          class="tisso-gift-banner__gift-button tisso-gift-banner__animated-button"
          data-tisso-popup-open
          aria-haspopup="dialog"
        >
          <span>{{ section.settings.topbar_button_text }}</span>
          <span class="tisso-gift-banner__button-arrow" aria-hidden="true">
            →
          </span>
        </button>
      {% endif %}
    </div>
    </div>

  <div class="tisso-gift-banner__mobile-header">

    <button
      type="button"
      class="tisso-gift-banner__menu-button"
      aria-label="{{ section.settings.menu_button_label }}"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="12" viewBox="0 0 20 12" fill="none">
<path d="M1 6H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M1 1H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M1 11H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
<path d="M1 13.9994L13.7279 1.27147" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M1 1L13.7279 13.7279" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
    </button>

    <div class="tisso-gift-banner__mobile-logo">
      <img src="{{ section.settings.logo_text | img_url: 'master' }}" />
    </div>

    <div class="tisso-gift-banner__mobile-spacer"></div>

  </div>

  <div class="tisso-gift-banner__hero">

   <picture>
  {% if section.settings.mobile_image != blank %}
    <source
      media="(max-width: 749px)"
      srcset="{{ section.settings.mobile_image | image_url: width: 1600 }}"
    >
  {% endif %}

  {% if section.settings.desktop_image != blank %}
    <source
      media="(min-width: 750px)"
      srcset="{{ section.settings.desktop_image | image_url: width: 2400 }}"
    >
  {% endif %}

  {% if section.settings.desktop_image != blank %}
    <img
      src="{{ section.settings.desktop_image | image_url: width: 2400 }}"
      alt="{{ section.settings.desktop_image.alt | escape }}"
      width="{{ section.settings.desktop_image.width }}"
      height="{{ section.settings.desktop_image.height }}"
      loading="lazy"
    >
  {% elsif section.settings.mobile_image != blank %}
    <img
      src="{{ section.settings.mobile_image | image_url: width: 1600 }}"
      alt="{{ section.settings.mobile_image.alt | escape }}"
      width="{{ section.settings.mobile_image.width }}"
      height="{{ section.settings.mobile_image.height }}"
      loading="lazy"
    >
  {% endif %}

  
</picture>

 {% if section.settings.show_shop_button %}
        <div class="tisso-gift-banner__cta-wrapper mobile-btn">

          {% if section.settings.shop_button_url != blank %}
            <a
              href="{{ section.settings.shop_button_url }}"
              class="tisso-gift-banner__shop-button tisso-gift-banner__animated-button"
            >
          {% else %}
            <button
              type="button"
              class="tisso-gift-banner__shop-button tisso-gift-banner__animated-button"
              data-tisso-popup-open
            >
          {% endif %}

              <span>{{ section.settings.shop_button_text }}</span>

              {% if section.settings.show_shop_arrow %}
                <span
                  class="tisso-gift-banner__shop-arrow"
                  aria-hidden="true"
                >
                  →
                </span>
              {% endif %}

          {% if section.settings.shop_button_url != blank %}
            </a>
          {% else %}
            </button>
          {% endif %}

        </div>
      {% endif %}


    <div class="tisso-gift-banner__overlay"></div>

    <div class="tisso-gift-banner__list-inner">
         <div class="page-width">
    <div class="tisso-gift-banner__content">

      {% if section.settings.heading != blank %}
        <h1 class="tisso-gift-banner__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="tisso-gift-banner__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.show_shop_button %}
        <div class="tisso-gift-banner__cta-wrapper desktop-btn">

          {% if section.settings.shop_button_url != blank %}
            <a
              href="{{ section.settings.shop_button_url }}"
              class="tisso-gift-banner__shop-button tisso-gift-banner__animated-button"
            >
          {% else %}
            <button
              type="button"
              class="tisso-gift-banner__shop-button tisso-gift-banner__animated-button"
              data-tisso-popup-open
            >
          {% endif %}

              <span>{{ section.settings.shop_button_text }}</span>

              {% if section.settings.show_shop_arrow %}
                <span
                  class="tisso-gift-banner__shop-arrow"
                  aria-hidden="true"
                >
                  →
                </span>
              {% endif %}

          {% if section.settings.shop_button_url != blank %}
            </a>
          {% else %}
            </button>
          {% endif %}

        </div>
      {% endif %}
</div>
</div>
    </div>

  </div>

  {% if section.settings.bottom_text != blank %}
    <div class="tisso-gift-banner__bottom-bar">
        <div class="page-width">
      {{ section.settings.bottom_text }}
        </div>
    </div>
  {% endif %}

  {% if section.settings.enable_popup %}

    <div
      class="tisso-gift-banner__popup"
      data-tisso-popup
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-labelledby="{{ section_id }}-popup-title"
    >

      <div
        class="tisso-gift-banner__popup-overlay"
        data-tisso-popup-close
      ></div>

      <div class="tisso-gift-banner__popup-content">

        <button
          type="button"
          class="tisso-gift-banner__popup-close"
          data-tisso-popup-close
          aria-label="{{ section.settings.popup_close_label }}"
        >
          ×
        </button>

        {% if section.settings.popup_image != blank %}
          <div class="tisso-gift-banner__popup-image">
            {{
              section.settings.popup_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1200',
                sizes: '(max-width: 749px) 90vw, 600px'
            }}
          </div>
        {% endif %}

        <div class="tisso-gift-banner__popup-text">

          {% if section.settings.popup_heading != blank %}
            <h2 id="{{ section_id }}-popup-title">
              {{ section.settings.popup_heading }}
            </h2>
          {% endif %}

          {% if section.settings.popup_description != blank %}
            <div class="tisso-gift-banner__popup-description">
              {{ section.settings.popup_description }}
            </div>
          {% endif %}

          {% if section.settings.popup_button_text != blank %}
            {% if section.settings.popup_button_url != blank %}

              <a
                href="{{ section.settings.popup_button_url }}"
                class="tisso-gift-banner__popup-button tisso-gift-banner__animated-button"
              >
                {{ section.settings.popup_button_text }}
              </a>

            {% else %}

              <button
                type="button"
                class="tisso-gift-banner__popup-button tisso-gift-banner__animated-button"
                data-tisso-popup-close
              >
                {{ section.settings.popup_button_text }}
              </button>

            {% endif %}
          {% endif %}

        </div>

      </div>
    </div>

  {% endif %}
</section>

<style>
body,body *{
    font-family: Jost, sans-serif !important;
}
    .page-width{
        max-width: 1440px;
        width: 100%;
        margin: 0 auto;
        padding: 0 50px;
    }
button{
    cursor: pointer;
}
  /*  TOP BAR */
  .tisso-gift-banner__topbar{
    width: 100%;
    background: {{ section.settings.topbar_bg_color }};
    padding: 10px 0;
}
  .tisso-gift-banner__topbar-inner{
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
}

.tisso-gift-banner__topbar-message{
    font-size: 16px;
    font-weight: 400;
    color: {{ section.settings.topbar_text_color }};
}
.tisso-gift-banner__topbar button{
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.topbar_btn_bg_color }};
    color: {{ section.settings.topbar_text_color }};
    border: none;
    gap: 18px;
    min-width: 207px;
    padding: 12px;
}

  /*  MOBILE HEADER  */

  #{{ section_id }} .tisso-gift-banner__mobile-header {
    display: none;
  }

  /*  HERO  */

  #{{ section_id }} .tisso-gift-banner__content {

    animation: tissoBannerContentIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .tisso-gift-banner__list-inner{
    position: absolute;
    bottom: 51px;
    left: 0;
    width: 100%;
  }
  .tisso-gift-banner__content h1{
    font-size: 70px;
    font-weight: 500;
    color: {{ section.settings.hero_text_color }};
    margin: 0 0 50px;
    letter-spacing: 0;
}
.tisso-gift-banner__description p{
    font-size: 20px;
    font-weight: 400;
    color: {{ section.settings.hero_text_color }};
    margin: 0 0 50px;
    letter-spacing: 0;
    line-height: 1.4;
}
.tisso-gift-banner__cta-wrapper button{
    font-size: 16px;
    font-weight: 400;
    color: #fff;
    background: {{ section.settings.hero_text_color }};
    border: none;
    padding: 12px;
    min-width: 220px;
    line-height: 1.6;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 29px;
    letter-spacing: 0;
}
.tisso-gift-banner__hero{
    position: relative;
    width: 100%;
}
.tisso-gift-banner__bottom-bar{
    width: 100%;
    text-align: center;
    background: {{ section.settings.bottombar_bg_color }};
    font-size: 16px;
    color: {{ section.settings.bottombar_text_color }};
    font-weight: 400;
    padding: 4px 0;
}


  /*  BUTTONS */

  #{{ section_id }} .tisso-gift-banner__animated-button {
    position: relative;
    overflow: hidden;

    transition:
      transform 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease;
  }

  #{{ section_id }} .tisso-gift-banner__animated-button::before {
    content: "";

    position: absolute;
    left: -110%;
    top: 0;

    width: 100%;
    height: 100%;

    background: rgba(255, 255, 255, 0.18);

    transform: skewX(-20deg);

    transition: left 0.45s ease;
  }

  #{{ section_id }} .tisso-gift-banner__animated-button:hover {
    transform: translateY(-2px);
  }

  #{{ section_id }} .tisso-gift-banner__shop-arrow {
    font-size: 25px;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  #{{ section_id }} .tisso-gift-banner__shop-button:hover .tisso-gift-banner__shop-arrow {
    transform: translateX(6px);
  }


  /*  POPUP */

  #{{ section_id }} .tisso-gift-banner__popup {
    position: fixed;
    inset: 0;

    z-index: 9999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 30px;

    visibility: hidden;
    opacity: 0;

    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  #{{ section_id }} .tisso-gift-banner__popup.is-open {
    visibility: visible;
    opacity: 1;
  }

  #{{ section_id }} .tisso-gift-banner__popup-overlay {
    position: absolute;
    inset: 0;

    background: rgba(0, 0, 0, 0.5);

    cursor: pointer;
  }

  #{{ section_id }} .tisso-gift-banner__popup-content {
    width: 100%;
    max-width: 620px;

    max-height: calc(100vh - 60px);

    position: relative;
    z-index: 2;

    overflow: auto;

    background: var(--tisso-popup-bg);

    transform: translateY(25px) scale(0.98);

    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #{{ section_id }} .tisso-gift-banner__popup.is-open .tisso-gift-banner__popup-content {
    transform: translateY(0) scale(1);
  }

  #{{ section_id }} .tisso-gift-banner__popup-close {
    position: absolute;
    top: 12px;
    right: 12px;

    width: 36px;
    height: 36px;

    border: 0;
    border-radius: 50%;

    background: rgba(0, 0, 0, 0.08);
    color: #000;

    display: flex;
    align-items: center;
    justify-content: center;

    font-family: inherit;
    font-size: 24px;
    line-height: 1;

    cursor: pointer;

    z-index: 3;
  }

  #{{ section_id }} .tisso-gift-banner__popup-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  #{{ section_id }} .tisso-gift-banner__popup-text {
    padding: 35px;
    text-align: center;
    background: #fff;
  }

  #{{ section_id }} .tisso-gift-banner__popup-text h2 {
    margin: 0 0 15px;

    font-size: 30px;
    line-height: 1.1;
  }

  #{{ section_id }} .tisso-gift-banner__popup-description {
    margin-bottom: 25px;

    font-size: 15px;
    line-height: 1.5;
  }

  #{{ section_id }} .tisso-gift-banner__popup-button {
    min-height: 48px;
    padding: 0 28px;

    border: 0;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    background: var(--tisso-button-bg);
    color: var(--tisso-button-text);

    font-family: inherit;
    font-size: 14px;

    text-decoration: none;
    cursor: pointer;
  }

  /* =========================
     LOAD ANIMATION
  ========================= */

  @keyframes tissoBannerContentIn {
    from {
      opacity: 0;
      transform: translateY(35px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =========================
     TABLET
  ========================= */

  /* =========================
     MOBILE
  ========================= */

  @media screen and (max-width: 767px) {

    #{{ section_id }} .tisso-gift-banner__topbar {
      display: none;
    }

    #{{ section_id }} .tisso-gift-banner__mobile-header {
      width: 100%;
      height: var(--tisso-header-height);

      padding: 0 16px;

      background: {{ section.settings.mobile_header_background }};

      display: grid;
      grid-template-columns: 40px 1fr 40px;
      align-items: center;

      position: relative;
      z-index: 10;
    }

  }

  @media (prefers-reduced-motion: reduce) {

    #{{ section_id }} .tisso-gift-banner__content {
      animation: none;
    }

    #{{ section_id }} .tisso-gift-banner__animated-button,
    #{{ section_id }} .tisso-gift-banner__animated-button::before,
    #{{ section_id }} .tisso-gift-banner__shop-arrow,
    #{{ section_id }} .tisso-gift-banner__popup,
    #{{ section_id }} .tisso-gift-banner__popup-content {
      transition: none;
    }

  }


  .desktop-btn{
    display: block !important;
}
  .mobile-btn{
    display: none !important;
  }
.tisso-gift-banner__mobile-drawer{
    display: none;
}
  @media(max-width: 1200px){
    .page-width{
        padding: 0 16px;
    }
    .tisso-gift-banner__content h1{
        font-size: 60px;
        margin: 0 0 40px;
    }
    .tisso-gift-banner__description p{
        font-size: 18px;
        margin: 0 0 40px;
    }
}

  @media(max-width: 991px){
    .tisso-gift-banner__content h1{
        font-size: 40px;
        margin: 0 0 20px;
    }
    .tisso-gift-banner__description p{
        font-size: 16px;
        margin: 0 0 20px;
    }
    .tisso-gift-banner__list-inner{
        bottom: 30px;
    }
}
.tisso-gift-banner__menu-button svg:first-child{
    display: block;
}
.tisso-gift-banner__menu-button svg:last-child{
    display: none;
}
@media(max-width: 767px){
    .tisso-gift-banner__mobile-drawer{
        width: 100%;
        display: block;
        text-align: center;
        background: {{ section.settings.topbar_bg_color }};
        padding: 25px 0;
        position: absolute;
        z-index: 99;
        top: 68px;
        left: 0;
        display: none;
    }
    .tisso-gift-banner__mobile-drawer.active{
        display: block;
    }
    .tisso-gift-banner__hero{
        display: flex;
        flex-wrap: wrap;
        text-align: center;
    }
   
    .tisso-gift-banner__mobile-drawer .tisso-gift-banner__topbar-message{
    font-size: 16px;
    font-weight: 400;
    color: {{ section.settings.topbar_text_color }};
    margin: 0 0 16px;
}
.tisso-gift-banner__mobile-drawer button{
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.topbar_btn_bg_color }};
    color: {{ section.settings.topbar_text_color }};
    border: none;
    gap: 18px;
    min-width: 244px;
    padding: 12px;
    margin: 0 auto;
}
    
   .tisso-gift-banner__list-inner{
    position: unset;
    order: -1;
    padding: 49px 0 0;
}
.tisso-gift-banner__bottom-bar{
    font-size: 14px;
}
.tisso-gift-banner__content h1{
    font-size: 30px;
    margin: 0 0 24px;
}
.tisso-gift-banner__cta-wrapper button{
    min-width: 193px;
    padding: 10px;
    margin: 0 auto;
}
.desktop-btn{
    display: none !important;
}
  .mobile-btn{
    display: block !important;
  }
  .tisso-gift-banner__cta-wrapper{
    position: absolute;
    bottom: 39px;
    left: 0;
    text-align: center;
    width: 100%;
}
.tisso-gift-banner__mobile-header{
    box-shadow: 0px 2px 4px 0px #00000026;
    background: {{ section.settings.topbar_bg_color }};
    padding: 23px 16px !important;
}
.tisso-gift-banner__mobile-logo img{
    max-height: 19px;
}
.tisso-gift-banner__menu-button{
    padding: 0;
    border: none;
    background: none;
}
.tisso-gift-banner__menu-button.active svg:first-child{
    display: none;
}
.tisso-gift-banner__menu-button.active svg:last-child{
    display: block;
}
}
</style>

<script>
  (() => {
    const section = document.getElementById('{{ section_id }}');

    if (!section) return;

    const popup = section.querySelector('[data-tisso-popup]');

    if (!popup) return;

    const openButtons = section.querySelectorAll('[data-tisso-popup-open]');
    const closeButtons = section.querySelectorAll('[data-tisso-popup-close]');

    let lastFocusedElement = null;

    const openPopup = () => {
      lastFocusedElement = document.activeElement;

      popup.classList.add('is-open');
      popup.setAttribute('aria-hidden', 'false');

      document.body.classList.add('tisso-popup-open');

      const closeButton = popup.querySelector('.tisso-gift-banner__popup-close');

      if (closeButton) {
        closeButton.focus();
      }
    };

    const closePopup = () => {
      popup.classList.remove('is-open');
      popup.setAttribute('aria-hidden', 'true');

      document.body.classList.remove('tisso-popup-open');

      if (
        lastFocusedElement &&
        typeof lastFocusedElement.focus === 'function'
      ) {
        lastFocusedElement.focus();
      }
    };

    openButtons.forEach((button) => {
      button.addEventListener('click', openPopup);
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', closePopup);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && popup.classList.contains('is-open')) {
        closePopup();
      }
    });
  })();

  document.addEventListener('DOMContentLoaded', function () {
  const menuButton = document.querySelector('.tisso-gift-banner__menu-button');
  const mobileDrawer = document.querySelector('.tisso-gift-banner__mobile-drawer');

  if (!menuButton || !mobileDrawer) return;

  menuButton.addEventListener('click', function () {
    menuButton.classList.toggle('active');
    mobileDrawer.classList.toggle('active');
  });
});

</script>

<style>
  body.tisso-popup-open {
    overflow: hidden;
  }
</style>

{% schema %}
{
  "name": "Tisso Gift Banner",
  "tag": "section",
  "class": "section-tisso-gift-banner",
  "settings": [
    {
      "type": "color",
      "id": "topbar_bg_color",
      "label": "Topbar Background Color"
    },
    {
      "type": "color",
      "id": "topbar_text_color",
      "label": "Topbar Text Color"
    },
    {
      "type": "color",
      "id": "topbar_btn_bg_color",
      "label": "Topbar Button Background Color"
    },
    {
      "type": "color",
      "id": "hero_text_color",
      "label": "Hero Text Color"
    },
    {
      "type": "color",
      "id": "bottombar_bg_color",
      "label": "Bottombar Background Color"
    },
    {
      "type": "color",
      "id": "bottombar_text_color",
      "label": "Bottombar Text Color"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
