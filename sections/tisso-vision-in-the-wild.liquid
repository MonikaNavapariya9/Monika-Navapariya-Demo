

{%- liquid
  assign companion_product = section.settings.companion_product

  if companion_product == blank
    assign companion_product = all_products['soft-winter-jacket']
  endif
-%}

<section
  id="tisso-vision-{{ section.id }}"
  class="tisso-vision"
  data-section-id="{{ section.id }}"
  data-companion-variant-id="{% if companion_product != blank %}{{ companion_product.selected_or_first_available_variant.id }}{% endif %}"
>
  <div class="page-width">

    <h1 class="tisso-vision__heading">
      {{ section.settings.heading | escape }}
    </h1>

    <div class="tisso-vision__grid">

      {% for block in section.blocks %}

        {% assign product = block.settings.product %}

        {% if product != blank %}

          {% assign product_variant = product.selected_or_first_available_variant %}

          <div
            class="tisso-card"
            {{ block.shopify_attributes }}
            data-product-card
            data-product-handle="{{ product.handle }}"
          >

            <button
              type="button"
              class="tisso-card__image-button"
              data-product-trigger
              aria-label="View {{ product.title | escape }}"
            >

              {% if product.featured_image %}

                {{
                  product.featured_image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'tisso-card__image',
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000',
                    sizes: '(min-width: 990px) 33vw, 50vw',
                    alt: product.featured_image.alt | default: product.title
                }}

              {% else %}

                {{ 'product-1' | placeholder_svg_tag: 'tisso-card__image tisso-card__placeholder' }}

              {% endif %}

              <span
                class="tisso-card__hotspot"
                data-product-trigger
                style="
                  left: {{ block.settings.hotspot_x }}%;
                  top: {{ block.settings.hotspot_y }}%;
                "
                aria-hidden="true"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
<circle cx="11" cy="11" r="11" fill="#F8F8F8" fill-opacity="0.9"/>
<path d="M11.3457 7.04175V15.5033" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
<path d="M7.11523 11.2725H15.5768" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
</svg>
              </span>

            </button>


            <!-- Product JSON -->

            <script type="application/json" data-product-json>
              {
                "id": {{ product.id | json }},
                "title": {{ product.title | json }},
                "description": {{ product.description | json }},
                "url": {{ product.url | json }},

                "featured_image":
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 1200 | json }}
                {% else %}
                  null
                {% endif %},

                "price": {{ product_variant.price | json }},

                "compare_at_price":
                {% if product_variant.compare_at_price %}
                  {{ product_variant.compare_at_price | json }}
                {% else %}
                  null
                {% endif %},

                "currency": {{ cart.currency.iso_code | json }},

                "options": {{ product.options_with_values | json }},

                "variants": [

                  {% for variant in product.variants %}

                    {
                      "id": {{ variant.id | json }},
                      "title": {{ variant.title | json }},
                      "available": {{ variant.available | json }},
                      "price": {{ variant.price | json }},

                      "compare_at_price":
                      {% if variant.compare_at_price %}
                        {{ variant.compare_at_price | json }}
                      {% else %}
                        null
                      {% endif %},

                      "option1": {{ variant.option1 | json }},
                      "option2": {{ variant.option2 | json }},
                      "option3": {{ variant.option3 | json }},

                      "featured_image":
                      {% if variant.featured_image %}
                        {{ variant.featured_image | image_url: width: 1200 | json }}
                      {% elsif product.featured_image %}
                        {{ product.featured_image | image_url: width: 1200 | json }}
                      {% else %}
                        null
                      {% endif %}
                    }

                    {% unless forloop.last %},{% endunless %}

                  {% endfor %}

                ]
              }
            </script>

        </div>

        {% else %}

          <article
            class="tisso-card tisso-card--empty"
            {{ block.shopify_attributes }}
          >
            <div class="tisso-card__empty-content">
              <span>Select a product</span>
            </div>
          </article>

        {% endif %}

      {% endfor %}

    </div>
  </div>


  <div
    class="tisso-modal"
    data-product-modal
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tisso-modal-title-{{ section.id }}"
  >

    <div
      class="tisso-modal__overlay"
      data-modal-close
    ></div>


    <div
      class="tisso-modal__content"
      role="document"
    >

      <button
        type="button"
        class="tisso-modal__close"
        data-modal-close
        aria-label="Close product details"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
<path d="M4.24219 4.24279L12.7275 12.7281" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
<path d="M4.24219 12.7278L12.7275 4.24249" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
</svg>
      </button>


      <div class="tisso-modal__body">

        <div class="tisso-modal__media">

          <img
            src=""
            alt=""
            width="800"
            height="800"
            data-modal-image
          >

        </div>


        <!-- PRODUCT DETAILS -->

        <div class="tisso-modal__details">

          <div class="tisso-modal__header">

            <h2
              id="tisso-modal-title-{{ section.id }}"
              class="tisso-modal__title"
              data-modal-title
            ></h2>


            <!-- PRICE -->

            <div
              class="tisso-modal__price"
              data-modal-price
            ></div>

          </div>


          <!-- DESCRIPTION -->

          <div
            class="tisso-modal__description rte"
            data-modal-description
          ></div>



        </div>

      </div>

          <form data-product-form>

            <!-- OPTIONS -->

            <div
              class="tisso-modal__options"
              data-modal-options
            ></div>


            <!-- STATUS -->

            <div
              class="tisso-modal__status"
              data-modal-status
            ></div>


            <!-- ADD TO CART -->

            <button
              type="submit"
              class="tisso-modal__add"
              data-add-to-cart
            >

              <span data-add-label>
                ADD TO CART
              </span>

              <span
                class="tisso-modal__arrow"
                aria-hidden="true"
              >
                →
              </span>

            </button>

          </form>

    </div>

  </div>


  <!-- TOAST -->

  <div
    class="tisso-toast"
    data-toast
    aria-live="polite"
    aria-atomic="true"
  ></div>

</section>


<style>
    .tisso-vision{
        width: 100%;
        padding: 90px 0 51px;
    }
.tisso-vision h1{
    font-size: 36px;
    font-weight: 400;
    color: #000;
    margin: 0 0 30px;
}
.tisso-vision__grid{
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}
.tisso-card{
    width: calc(33.3333% - 20px);
    position: relative;
    line-height: 0;
}
.tisso-card button{
    padding: 0;
    border: none;
}
.tisso-card__hotspot{
    position: absolute;
    top: 0;
    left: 0;
}
.tisso-modal{
    width: 100%;
    position: fixed;
    height: 100vh;
    top: 0;
    left: 0;
    background: rgba(0,0,0,0.5);
    z-index: 999;
    display: none;
}
.tisso-modal.is-open{
    display: block;
}
.tisso-modal__content{
    width: 100%;
    max-width: 311px;
    box-shadow: 0px 2px 4px 0px #00000033;
    background: #fff;
    margin: 5vh auto;
    max-height: 90vh;
    overflow: auto;
    position: relative;
}
.tisso-modal__close{
    width: 32px;
    height: 34px;
    padding: 5px;
    position: absolute;
    top: 0;
    right: 0;
    border: none;
    background: none;
}
.tisso-modal__body{
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    padding: 36px 17px 0;
}
.tisso-modal__media{
    width: 50%;
}
.tisso-modal__details{
    width: 50%;
    padding-left: 8px;
}
.tisso-modal__header h2{
    font-size: 16px;
    color: #000;
    font-weight: 300;
    margin: 0 0 20px;
}
.tisso-modal__price{
    font-size: 16px;
    color: #000;
    font-weight: 400;
    margin: 0 0 12px;
}
.tisso-modal__description.rte p{
    letter-spacing: -1%;
    font-size: 14px;
    font-weight: 300;
    color: #000;
    line-height: 1.1;
}
.tisso-modal__content form{
    padding: 10px 20px 25px;
}
.tisso-option label{
    font-size: 14px;
    color: #333333;
    font-weight: 400;
    margin: 0 0 6px;
}
.tisso-color-buttons{
    width: 100%;
    display: flex;
}
.tisso-color-buttons button{
    width: 50%;
    border: 0.5px solid #000;
    font-size: 18px;
    font-weight: 400;
    color: #000;
    position: relative;
    text-align: left;
    background: none;
    padding: 6px 0 6px 15px;
    transition: 0.3s all ease-in-out;
    -webkit-transition: 0.3s all ease-in-out;
    -o-transition: 0.3s all ease-in-out;
    -moz-transition: 0.3s all ease-in-out;
    -ms-transition: 0.3s all ease-in-out;
}
.tisso-color-buttons button:after{
    content: '';
    width: 6px;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 9;
    border-right: solid 1px #000;
}
.tisso-color-buttons button.Black:after{
    background: #000;
}
.tisso-color-buttons button.White:after{
    background: #fff;
}
.tisso-color-buttons button.Blue:after{
    background: #0D499F;
}
.tisso-option{
    width: 100%;
    padding: 0 0 11px;
}
.tisso-modal__media img{
    height: 100%;
    object-fit: cover;
}
.tisso-option__select{
    width: 100%;
    border-radius: 0;
    border: 0.5px solid #000000;
    height: 40px;
    padding: 0 13px;
    appearance: none;
}
.tisso-option__select-wrap:after{
    content: '';
    width: 0.5px;
    height: 100%;
    position: absolute;
    top: 0;
    right: 55px;
    background: #000;
}
.tisso-option__select-wrap{
    width: 100%;
    position: relative;
}
.tisso-option__select-wrap:before{
    content: '';
    width: 12px;
    height: 6px;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    -webkit-transform: translateY(-50%);
    -o-transform: translateY(-50%);
    -moz-transform: translateY(-50%);
    -ms-transform: translateY(-50%);
    right: 21px;
    background: url('https://cdn.shopify.com/s/files/1/0937/3230/7217/files/Vector_21.png?v=1789311158') no-repeat center center;
    background-size: contain;
}
.tisso-modal__add{
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    text-transform: uppercase;
    font-weight: 400;
    background: #000;
    color: #fff;
    border: none;
    width: 100%;
    padding: 11px;
    gap: 28px;
}
.tisso-modal__options{
    width: 100%;
    padding: 0 0 40px;
}
.tisso-color-button.is-selected{
    background: #000;
    color: #fff;
}
@media(max-width: 1200px){
    .tisso-vision{
        padding: 40px 0;
    }
    .tisso-vision h1{
        margin: 0 0 20px;
    }
}
@media(max-width: 767px){
    .tisso-vision h1{
        font-size: 24px;
        text-align: center;
    }
    .tisso-vision__grid{
        gap: 4px;
    }
    .tisso-card{
        width: calc(50% - 4px);
    }
}
  
</style>


<script>

(() => {

  'use strict';

  const section =
    document.getElementById(
      'tisso-vision-{{ section.id }}'
    );


  if (!section) {
    return;
  }

  if (
    section.dataset.initialized === 'true'
  ) {
    return;
  }

  section.dataset.initialized = 'true';
  const modal =
    section.querySelector(
      '[data-product-modal]'
    );

  const modalImage =
    section.querySelector(
      '[data-modal-image]'
    );

  const modalTitle =
    section.querySelector(
      '[data-modal-title]'
    );

  const modalPrice =
    section.querySelector(
      '[data-modal-price]'
    );

  const modalDescription =
    section.querySelector(
      '[data-modal-description]'
    );

  const modalOptions =
    section.querySelector(
      '[data-modal-options]'
    );

  const modalStatus =
    section.querySelector(
      '[data-modal-status]'
    );

  const productForm =
    section.querySelector(
      '[data-product-form]'
    );

  const addButton =
    section.querySelector(
      '[data-add-to-cart]'
    );

  const addLabel =
    section.querySelector(
      '[data-add-label]'
    );

  const toast =
    section.querySelector(
      '[data-toast]'
    );


  const companionVariantId =
    section.dataset.companionVariantId;

  let activeProduct = null;

  let selectedVariant = null;

  let previousFocusedElement = null;

  let toastTimer = null;


  const formatMoney = (cents) => {

    if (
      window.Shopify &&
      typeof window.Shopify.formatMoney === 'function'
    ) {

      return window.Shopify.formatMoney(cents);

    }


    return new Intl.NumberFormat(
      undefined,
      {
        style: 'currency',

        currency:
          '{{ cart.currency.iso_code }}'
      }
    ).format(
      cents / 100
    );

  };


  const showToast = (message) => {

    if (!toast) {
      return;
    }


    toast.textContent = message;

    toast.classList.add(
      'is-visible'
    );


    clearTimeout(toastTimer);


    toastTimer =
      setTimeout(() => {

        toast.classList.remove(
          'is-visible'
        );

      }, 3000);

  };

  const getProductFromCard =
    (card) => {

      const jsonElement =
        card.querySelector(
          '[data-product-json]'
        );


      if (!jsonElement) {
        return null;
      }


      try {

        return JSON.parse(
          jsonElement.textContent
        );

      } catch (error) {

        console.error(
          'Unable to parse product data:',
          error
        );

        return null;
      }

    };

  const getCurrentSelections =
    () => {

      const selections = {};

      const controls =
        modalOptions.querySelectorAll(
          '[data-option-index]'
        );


      controls.forEach((control) => {

        const index =
          Number(
            control.dataset.optionIndex
          );


        selections[index] =
          control.value;

      });


      return selections;
    };

  const findVariant =
    () => {

      if (!activeProduct) {
        return null;
      }


      const selections =
        getCurrentSelections();


      return (
        activeProduct.variants.find(
          (variant) => {

            return Object.keys(
              selections
            ).every(
              (index) => {

                const optionNumber =
                  Number(index) + 1;

                return (
                  String(
                    variant[
                      `option${optionNumber}`
                    ] || ''
                  ) ===
                  String(
                    selections[index]
                  )
                );

              }
            );

          }
        ) || null
      );

    };

  const updatePrice =
    (variant) => {

      if (!variant) {
        return;
      }


      let priceHTML =
        formatMoney(
          variant.price
        );


      if (
        variant.compare_at_price &&
        variant.compare_at_price >
          variant.price
      ) {

        priceHTML +=
          ' <s>' +
          formatMoney(
            variant.compare_at_price
          ) +
          '</s>';

      }


      modalPrice.innerHTML =
        priceHTML;

    };

  const updateVariantUI =
    () => {

      selectedVariant =
        findVariant();
      if (!selectedVariant) {

        modalStatus.textContent =
          'This combination is unavailable.';

        addButton.disabled = true;

        addLabel.textContent =
          'UNAVAILABLE';

        return;
      }

      updatePrice(
        selectedVariant
      );

      if (
        selectedVariant.featured_image
      ) {

        modalImage.src =
          selectedVariant.featured_image;

      }

      if (
        !selectedVariant.available
      ) {

        modalStatus.textContent =
          'This variant is currently unavailable.';

        addButton.disabled = true;

        addLabel.textContent =
          'SOLD OUT';

      } else {

        modalStatus.textContent = '';

        addButton.disabled = false;

        addLabel.textContent =
          'ADD TO CART';

      }

    };

  const createDropdown =
    (
      option,
      optionIndex,
      firstVariant
    ) => {

      const wrapper =
        document.createElement('div');

      wrapper.className =
        'tisso-option';


      const label =
        document.createElement('label');

      label.className =
        'tisso-option__label';

      label.textContent =
        option.name;


      const selectWrap =
        document.createElement('div');

      selectWrap.className =
        'tisso-option__select-wrap';


      const select =
        document.createElement('select');

      select.className =
        'tisso-option__select';

      select.dataset.optionIndex =
        String(optionIndex);


      select.setAttribute(
        'aria-label',
        option.name
      );


      const uniqueValues =
        [...new Set(option.values)];


      uniqueValues.forEach(
        (value) => {

          const optionElement =
            document.createElement(
              'option'
            );

          optionElement.value =
            value;

          optionElement.textContent =
            value;

          select.appendChild(
            optionElement
          );

        }
      );
      if (firstVariant) {

        const initialValue =
          firstVariant[
            `option${optionIndex + 1}`
          ];


        if (initialValue) {

          select.value =
            initialValue;

        }

      }

      select.addEventListener(
        'change',
        () => {

          updateVariantUI();

        }
      );


      selectWrap.appendChild(
        select
      );

      wrapper.appendChild(
        label
      );

      wrapper.appendChild(
        selectWrap
      );


      modalOptions.appendChild(
        wrapper
      );

    };

  const createColorButtons =
    (
      option,
      optionIndex,
      firstVariant
    ) => {

      const wrapper =
        document.createElement('div');

      wrapper.className =
        'tisso-option';


      const label =
        document.createElement('div');

      label.className =
        'tisso-option__label';

      label.textContent =
        option.name;


      const buttons =
        document.createElement('div');

      buttons.className =
        'tisso-color-buttons';


      const uniqueValues =
        [...new Set(option.values)];


      uniqueValues.forEach(
        (value, valueIndex) => {

          const button =
            document.createElement(
              'button'
            );

          button.type =
            'button';

          button.className =
            'tisso-color-button '+value;

          button.textContent =
            value;

          button.dataset.optionIndex =
            String(optionIndex);

          button.dataset.value =
            value;

          if (
            firstVariant &&
            firstVariant[
              `option${optionIndex + 1}`
            ] === value
          ) {

            button.classList.add(
              'is-selected'
            );

          }

          button.addEventListener(
            'click',
            () => {

              buttons
                .querySelectorAll(
                  '.tisso-color-button'
                )
                .forEach(
                  (item) => {

                    item.classList.remove(
                      'is-selected'
                    );

                  }
                );


              button.classList.add(
                'is-selected'
              );

              let hiddenSelect =
                modalOptions.querySelector(
                  `select[data-option-index="${optionIndex}"]`
                );


              if (!hiddenSelect) {

                hiddenSelect =
                  document.createElement(
                    'select'
                  );

                hiddenSelect.style.display =
                  'none';

                hiddenSelect.dataset.optionIndex =
                  String(optionIndex);

                modalOptions.appendChild(
                  hiddenSelect
                );

              }


              hiddenSelect.value =
                value;


              updateVariantUI();

            }
          );


          buttons.appendChild(
            button
          );

        }
      );


      wrapper.appendChild(
        label
      );

      wrapper.appendChild(
        buttons
      );

      const hiddenSelect =
        document.createElement(
          'select'
        );

      hiddenSelect.style.display =
        'none';

      hiddenSelect.dataset.optionIndex =
        String(optionIndex);


      uniqueValues.forEach(
        (value) => {

          const optionElement =
            document.createElement(
              'option'
            );

          optionElement.value =
            value;

          optionElement.textContent =
            value;

          hiddenSelect.appendChild(
            optionElement
          );

        }
      );


      if (firstVariant) {

        hiddenSelect.value =
          firstVariant[
            `option${optionIndex + 1}`
          ];

      }


      wrapper.appendChild(
        hiddenSelect
      );


      modalOptions.appendChild(
        wrapper
      );

    };

  const renderOptions =
    (product) => {

      modalOptions.innerHTML =
        '';


      if (
        !product.options ||
        !product.options.length
      ) {

        return;

      }


      const firstVariant =
        product.variants.find(
          (variant) =>
            variant.available
        ) ||
        product.variants[0];


      product.options.forEach(
        (
          option,
          optionIndex
        ) => {

          const optionName =
            String(
              option.name
            )
              .trim()
              .toLowerCase();

          if (
            optionName === 'color' ||
            optionName === 'colour'
          ) {

            createColorButtons(
              option,
              optionIndex,
              firstVariant
            );

          }

          else {

            createDropdown(
              option,
              optionIndex,
              firstVariant
            );

          }

        }
      );

    };

  const openModal =
    (
      product,
      trigger
    ) => {

      if (!product) {
        return;
      }


      activeProduct =
        product;


      previousFocusedElement =
        trigger ||
        document.activeElement;


      modalTitle.textContent =
        product.title;


      modalDescription.innerHTML =
        product.description || '';


      modalImage.src =
        product.featured_image || '';


      modalImage.alt =
        product.title;
      renderOptions(
        product
      );

      updateVariantUI();


      modal.classList.add(
        'is-open'
      );


      modal.setAttribute(
        'aria-hidden',
        'false'
      );


      document.documentElement.classList.add(
        'tisso-modal-open'
      );


      setTimeout(
        () => {

          const firstFocusable =
            modal.querySelector(
              'button, select'
            );


          if (
            firstFocusable
          ) {

            firstFocusable.focus();

          }

        },
        20
      );

    };
  const closeModal =
    () => {

      modal.classList.remove(
        'is-open'
      );


      modal.setAttribute(
        'aria-hidden',
        'true'
      );


      document.documentElement.classList.remove(
        'tisso-modal-open'
      );


      activeProduct =
        null;


      selectedVariant =
        null;


      if (
        previousFocusedElement &&
        typeof previousFocusedElement.focus ===
          'function'
      ) {

        previousFocusedElement.focus();

      }

    };
  const addToCart =
    async (items) => {

      const response =
        await fetch(
          `${window.Shopify.routes.root}cart/add.js`,
          {
            method: 'POST',

            headers: {
              'Content-Type':
                'application/json',

              'Accept':
                'application/json'
            },

            body:
              JSON.stringify({
                items
              })
          }
        );


      const data =
        await response.json();


      if (!response.ok) {

        throw new Error(
          data.description ||
          'Unable to add product to cart.'
        );

      }

      return data;

    };

  const requiresCompanionProduct =
    (variant) => {

      if (!variant) {
        return false;
      }


      const values = [
        variant.option1,
        variant.option2,
        variant.option3
      ]
        .filter(Boolean)
        .map(
          (value) =>
            String(value)
              .trim()
              .toLowerCase()
        );


      return (
        values.includes('black') &&
        values.includes('medium')
      );

    };
  const handleSubmit =
    async (event) => {

      event.preventDefault();


      if (
        !selectedVariant ||
        !selectedVariant.available
      ) {

        return;

      }


      addButton.disabled =
        true;


      addLabel.textContent =
        'ADDING...';


      try {

        const items = [

          {
            id:
              Number(
                selectedVariant.id
              ),

            quantity: 1
          }

        ];

        if (
          requiresCompanionProduct(
            selectedVariant
          ) &&
          companionVariantId
        ) {

          if (
            String(
              companionVariantId
            ) !==
            String(
              selectedVariant.id
            )
          ) {

            items.push({

              id:
                Number(
                  companionVariantId
                ),

              quantity: 1

            });

          }

        }


        await addToCart(
          items
        );


        const companionWasAdded =
          items.length > 1;


        closeModal();


        if (
          companionWasAdded
        ) {

          showToast(
            'Added to cart, including Soft Winter Jacket.'
          );

        } else {

          showToast(
            'Added to cart.'
          );

          window.location.href = '/cart'

        }

        document.dispatchEvent(
          new CustomEvent(
            'cart:updated',
            {
              detail: {
                items
              }
            }
          )
        );
        const cartDrawer =
          document.querySelector(
            'cart-drawer'
          );


        if (
          cartDrawer &&
          typeof cartDrawer.open ===
            'function'
        ) {

          cartDrawer.open();

        }

      } catch (error) {

        console.error(
          error
        );


        modalStatus.textContent =
          error.message ||
          'Unable to add product to cart.';


        addLabel.textContent =
          'ADD TO CART';


        addButton.disabled =
          false;

      }

    };
  section
    .querySelectorAll(
      '[data-product-card]'
    )
    .forEach(
      (card) => {

        const product =
          getProductFromCard(
            card
          );


        card
          .querySelectorAll(
            '[data-product-trigger]'
          )
          .forEach(
            (trigger) => {

              trigger.addEventListener(
                'click',
                () => {

                  openModal(
                    product,
                    trigger
                  );

                }
              );

            }
          );

      }
    );

  modal
    .querySelectorAll(
      '[data-modal-close]'
    )
    .forEach(
      (element) => {

        element.addEventListener(
          'click',
          closeModal
        );

      }
    );

  document.addEventListener(
    'keydown',
    (event) => {

      if (
        event.key === 'Escape' &&
        modal.classList.contains(
          'is-open'
        )
      ) {

        closeModal();

      }

    }
  );

  productForm.addEventListener(
    'submit',
    handleSubmit
  );

})();

</script>


